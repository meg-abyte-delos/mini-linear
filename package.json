{
  "name": "mini-linear",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:e2e-reset": "E2E_ISOLATED=1 tsx scripts/e2e-db.mts",
    "test:e2e:isolated": "pnpm db:e2e-reset && E2E_ISOLATED=1 playwright test",
    "test:visual": "pnpm db:e2e-reset && E2E_ISOLATED=1 playwright test tests/e2e/00-visual.spec.ts",
    "test:visual:update": "pnpm db:e2e-reset && E2E_ISOLATED=1 playwright test tests/e2e/00-visual.spec.ts --update-snapshots",
    "db:migrate": "for f in db/migrations/*.sql; do psql \"$DATABASE_OWNER_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done",
    "db:seed-demo": "tsx scripts/seed-demo.mts",
    "db:seed-demo-rich": "tsx scripts/seed-demo-rich.mts",
    "check:rls": "tsx scripts/check-rls.mts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.14.0",
    "pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
