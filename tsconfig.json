{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "ES2022"], "module": "esnext", "moduleResolution": "bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "jsx": "preserve", "noEmit": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true,
    "incremental": true, "paths": { "@/*": ["./src/*"] }, "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src", "tests", "scripts", "*.ts"],
  "exclude": ["node_modules"]
}
